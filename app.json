{
  "expo": {
    "name": "Bill Splitter",
    "slug": "bill-splitter-mobile",
    "version": "1.0.0",
    "userInterfaceStyle": "light",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f8fafc"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ptimsina.billsplitter",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ptimsina.billsplitter",
      "versionCode": 28,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0ea5e9"
      }
    },
    "plugins": [
      "./plugins/fix-bundle-path.js",
      [
        "expo-build-properties",
        {
          "android": {
            "newArchEnabled": false,
            "hermesEnabled": false
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "444c01f3-181e-4e65-8aa2-9c84fd3548d3"
      }
    },
    "owner": "pravatktimsina"
  }
}
